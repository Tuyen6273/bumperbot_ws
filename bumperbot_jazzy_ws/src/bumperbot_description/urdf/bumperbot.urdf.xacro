<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro" name="bumperbot">

    <!-- Mặc định dùng Ignition; có thể đổi khi chạy bằng is_ignition:=false. -->
    <xacro:arg name="is_ignition" default="true"/>
    <!--Chạy robot thật hay là robot mô phỏng-->
    <xacro:arg name="is_sim" default="true"/> 

    <xacro:include filename = "$(find bumperbot_description)/urdf/bumperbot_gazebo.urdf.xacro"/>

    <!--Ros2 control-->
    <xacro:include filename = "$(find bumperbot_description)/urdf/bumperbot_ros2_control.xacro"/>
    <link name = 'base_footprint' />
    <!--Khai bao khớp và link base-->
    <link name = 'base_link'>
        <!-- Theo anh Mass Properties cua base: dung COM va Lxx..Lzz tai COM.
             g -> kg; mm -> m; g*mm^2 -> kg*m^2 (x 1e-9).
             Doi dau cac tich quan tinh SolidWorks sang phan tu tensor URDF.
             Ap dung truc va toa do Coordinate System1 truc tiep cho base_link. -->
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1.86646"/>
            <inertia ixx="0.01526994144" ixy="2.51002e-06" ixz="7.214361e-05"
                     iyy="0.03974477763" iyz="-4.9692e-07" izz="0.04941585770"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename = "package://bumperbot_description/meshes/base.STL" scale = "0.001 0.001 0.001"/>
            </geometry>
        </visual>

        <!-- Hop bao STL: x/y = +/-0.25/0.15 m, z = -0.035..0.11 m. -->
        <collision>
            <origin xyz="0 0 0.0375" rpy="0 0 0"/>
            <geometry>
                <box size="0.5 0.3 0.145"/>
            </geometry>
        </collision>
    </link>
    
    <joint name = 'base_footprint_joint' type = 'fixed'>
        <parent link ='base_footprint'/>
        <child link = 'base_link'/>
        <origin rpy="0 0 0" xyz="0 0 0.05413"/>
    </joint>

    <!--______________________________________________________________________________________________-->
    <!--Khai bao khớp và link cho bánh xe phải-->

    <link name = "wheel_right_link" >
        <!-- SolidWorks: g -> kg, g*mm^2 -> kg*m^2 (x 1e-9).
             Doi dau cac tich quan tinh (positive tensor notation) cho URDF.
             COM va truc quan tinh duoc xoay cung mesh quanh X: -pi/2. -->
        <inertial>
            <origin xyz="0 -0.00004 0" rpy="0 0 0"/>
            <mass value="0.03517"/>
            <inertia ixx="1.538638e-05" ixy="-4.7e-10" ixz="0"
                     iyy="1.538669e-05" iyz="0" izz="2.578589e-05"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename = "package://bumperbot_description/meshes/wheel_68mm.STL" scale = "0.001 0.001 0.001"/>
            </geometry> 

            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <!-- Tru banh theo STL: R=34 mm, day=31.75 mm, tam Z=-2.375 mm.
             Xoay -pi/2 dua truc tru sang Y va tam sang Y=-2.375 mm. -->
        <collision>
            <origin xyz="0 -0.002375 0" rpy="${-pi/2} 0 0"/>
            <geometry>
                <cylinder radius="0.034" length="0.03175"/>
            </geometry>
        </collision>
    </link>

    <joint name = "wheel_right_base_joint" type = "continuous">
        <parent link = "base_link"/>
        <child link = "wheel_right_link"/>
        <origin xyz="0 -0.12825 -0.02013" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name = "wheel_left_link" >
        <!-- Cung thong so banh phai; COM va truc quan tinh xoay +pi/2. -->
        <inertial>
            <origin xyz="0 0.00004 0" rpy="0 0 0"/>
            <mass value="0.03517"/>
            <inertia ixx="1.538638e-05" ixy="-4.7e-10" ixz="0"
                     iyy="1.538669e-05" iyz="0" izz="2.578589e-05"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="${-pi} ${-pi} 0"/>
            <geometry>
                <mesh filename = "package://bumperbot_description/meshes/wheel_68mm.STL" scale = "0.001 0.001 0.001"/>
            </geometry> 

            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <!-- Banh trai doi xung: tam tru Y=+2.375 mm. -->
        <collision>
            <origin xyz="0 0.002375 0" rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="0.034" length="0.03175"/>
            </geometry>
        </collision>
    </link>

    <joint name = "wheel_left_base_joint" type = "continuous">
        <parent link = "base_link"/>
        <child link = "wheel_left_link"/>
        <origin xyz="0 +0.12825 -0.02013" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name = "caster_front_link" >
        <!-- Quan tinh tai COM tu SolidWorks, don vi kg va kg*m^2. -->
        <inertial>
            <origin xyz="-0.00003 0 0.00376" rpy="0 0 0"/>
            <mass value="0.00452"/>
            <inertia ixx="3.3451e-07" ixy="0" ixz="-1.5e-10"
                     iyy="2.4987e-07" iyz="0" izz="2.9746e-07"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename = "package://bumperbot_description/meshes/ban_mat_trau_hoan_chinh.STL" scale = "0.001 0.001 0.001"/>
            </geometry> 

            <material name="black">
                <color rgba="0 1 0 1"/>
            </material>
        </visual>
        <!-- Chi mo phong vien bi tiep dat R=8 mm, tam tai goc link.
             Gia do caster van hien thi bang STL. -->
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.008"/>
            </geometry>
        </collision>
    </link>

    <joint name = "caster_front_base_joint" type = "fixed">
        <parent link = "base_link"/>
        <child link = "caster_front_link"/>
        <origin xyz="0.21 0.0 -0.04613" rpy="0 0 0"/>
    </joint>

    <link name = "caster_rear_link" >
        <inertial>
            <origin xyz="-0.00003 0 0.00376" rpy="0 0 0"/>
            <mass value="0.00452"/>
            <inertia ixx="3.3451e-07" ixy="0" ixz="-1.5e-10"
                     iyy="2.4987e-07" iyz="0" izz="2.9746e-07"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename = "package://bumperbot_description/meshes/ban_mat_trau_hoan_chinh.STL" scale = "0.001 0.001 0.001"/>
            </geometry> 

            <material name="black">
                <color rgba="0 1 0 1"/>
            </material>
        </visual>
        <!-- Vien bi caster sau cung R=8 mm nhu caster truoc. -->
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.008"/>
            </geometry>
        </collision>
    </link>

    <joint name = "caster_rear_base_joint" type = "fixed">
        <parent link = "base_link"/>
        <child link = "caster_rear_link"/>
        <origin xyz="-0.21 0.0 -0.04613" rpy="0 0 0"/>
    </joint>

        <!--Khai bao khớp và link cho cảm biến IMU-->
    <link name = "imu_link">
        <inertial>

        <origin xyz="-0.00552433659106688 0.000168210391520346 0.000514000497342681" rpy="0 0 0" />

        <mass value="0.000528415362211671" />

        <inertia  ixx="1.46176048428261E-08" ixy="1.40015117949421E-10" ixz="-1.99633872937403E-12"

                iyy="8.59662482954888E-09" iyz="7.52375112767959E-12"

                izz="2.30279421279312E-08" />

        </inertial>

        <visual>
            <origin xyz = "0 0 0" rpy = "0 0 0"/>
            <geometry>
                <mesh filename="package://bumperbot_description/meshes/IMU.STL" scale = "0.001 0.001 0.001"/>
            </geometry>
            <material name="green">
                <color rgba="0.5 0.6 0.7 1"/>
            </material>

        </visual>

        <!-- Hop bao IMU theo STL, don vi m. -->
        <collision>
            <origin xyz="0.0025 0 0.0035" rpy="0 0 0"/>
            <geometry>
                <box size="0.037 0.032 0.007"/>
            </geometry>
        </collision>
    </link>

    <joint name="imu_base_joint" type = "fixed">
        <parent link = "base_link"/>
        <child link = "imu_link"/>
        <origin xyz="0 0 0.04" rpy="0 0 0"/>
        <axis xyz="0 0 0"/>
    </joint>

</robot>
