<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro" name="bumperbot">

    <!--
        Khối ros2_control mô tả phần cứng mà ROS 2 sẽ điều khiển.
        type="system" nghĩa là robot có nhiều khớp được quản lý như một hệ thống.
    -->
    <ros2_control name="BumperbotSystem" type="system">
        <xacro:if value="$(arg is_sim)">
            <hardware>
            <!--
                Khi is_ignition=false, dùng Gazebo Sim (gz) và nạp plugin này.
                Nếu is_ignition=true, plugin ign_ros2_control trong
                bumperbot_gazebo.urdf.xacro sẽ đảm nhiệm việc kết nối mô phỏng.
            -->
            <xacro:unless value="$(arg is_ignition)">
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </xacro:unless>

            <xacro:if value ="$(arg is_ignition)">
                <plugin>ign_ros2_control/IgnitionSystem</plugin>
            </xacro:if>
        </hardware>
        </xacro:if>

        <xacro:unless value="$(arg is_sim)">
            <hardware>
                <plugin>bumperbot_firmware/BumperbotInterface</plugin>
                <param name = "port" >/dev/ttyUSB0</param>
                <param name = "fallback_port" >/dev/ttyACM0</param>
            </hardware>
        </xacro:unless>
        

        <!-- Khớp bánh phải: ROS 2 gửi vận tốc và nhận vị trí, vận tốc thực tế. -->
        <joint name="wheel_right_base_joint">
            <command_interface name="velocity"> <!--command interface: giao diện này xác đinh cách ghi dữ liệu xuống phần cưng-->
                <!-- Giới hạn vận tốc góc của bánh xe: -1 đến 1 rad/s. -->
                <param name="min">-1</param>
                <param name="max">1</param>
            </command_interface><!--state interface: giao diện này xác định cách đọc dữ liệu từ phần cứng-->
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <!-- Khớp bánh trái: cấu hình tương tự bánh phải. -->
        <joint name="wheel_left_base_joint">
            <command_interface name="velocity"> <!--command interface: giao diện này xác đinh cách ghi dữ liệu xuống phần cưng-->
                <param name="min">-1</param>
                <param name="max">1</param>
            </command_interface><!--state interface: giao diện này xác định cách đọc dữ liệu từ phần cứng-->
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </ros2_control>

</robot>
